{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "OyePick Store — live WordPress demo",
    "description": "WooCommerce store with the OyePick theme, 12 products, cash on delivery, reviews and purchase notifications.",
    "author": "bilalce109",
    "categories": ["WooCommerce"]
  },
  "landingPage": "/",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "features": { "networking": true },
  "login": true,
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "OyePick",
        "blogdescription": "Trending styles & tech accessories",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": { "resource": "wordpress.org/plugins", "slug": "woocommerce" },
      "options": { "activate": true }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/bilalce109/oyepick",
        "ref": "main",
        "refType": "branch",
        "path": "wordpress/oyepick-theme"
      },
      "options": { "activate": true }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/bilalce109/oyepick",
        "ref": "main",
        "refType": "branch",
        "path": "wordpress/oyepick-store-setup"
      },
      "options": { "activate": true }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; oyepick_setup_run( array( 'demo_orders' => true ) );"
    }
  ]
}
